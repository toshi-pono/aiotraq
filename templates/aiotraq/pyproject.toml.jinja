{% set poetry = meta == "poetry" %}
{% set pdm = meta == "pdm" %}
{% if poetry or pdm %}
{% if poetry %}[tool.poetry]
{% elif pdm %}[project]
{% endif %}
name = "{{ project_name }}"
version = "{{ package_version | in_double_quote_literal }}"
description = "Async ready traQ API Client"
authors = ["toshi00"]
license = "MIT"
readme = "README.md"
{% if pdm %}requires-python = ">=3.11,<4.0"{% endif %}
{% if poetry %}
packages = [{ include = "{{ package_name }}" }]
include = ["{{ package_name }}/py.typed", "LICENSE"]
{% endif %}
repository = "https://github.com/toshi-pono/aiotraq"
keywords = ["traQ", "API", "async", "httpx"]


{% if pdm %}
dependencies = [
    "httpx>=0.27.2,<0.28.0",
    "attrs>=22.2.0",
    "httpcore>=1.0.9,<2",
    "anyio>=4.14.2,<5",
    "certifi>=2026.10.19",
    "idna>=3.15,<4",
    "python-dateutil>=2.8.0",
]

[tool.pdm]
distribution = true
{% endif %}
{% if poetry %}
[tool.poetry.urls]
"Source Code" = "https://github.com/toshi-pono/aiotraq/tree/main/libs/aiotraq"

[tool.poetry.dependencies]
python = ">=3.11,<4.0"
httpx = ">=0.27.2,<0.28.0"
httpcore = ">=1.0.9,<2"
anyio = ">=4.14.2,<5"
certifi = ">=2026.10.19"
idna = ">=3.15,<4"
attrs = ">=22.2.0"
python-dateutil = "^2.8.0"

[tool.poetry.group.dev.dependencies]
types-python-dateutil = "^2.8.0"
mypy = "^1.10.0"
ruff = "==0.4.10"
{% endif %}

[build-system]
{% if poetry %}
requires = ["poetry-core==2.4.0"]
build-backend = "poetry.core.masonry.api"
{% elif pdm %}
requires = ["pdm-backend"]
build-backend = "pdm.backend"
{% endif %}
{% endif %}{# poetry or pdm #}

{% include "pyproject_mypy.toml.jinja" %}

{% include "pyproject_ruff.toml.jinja" %}
